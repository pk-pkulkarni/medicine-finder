DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Use the Supabase IPv4 session pooler for Render/free hosts.
# URL-encode special password characters: @ becomes %40.
DATABASE_URL=postgresql://postgres.bleztdeqdgijhmyymdsn:<database-password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# Optional Supabase Storage S3-compatible file storage.
USE_S3_STORAGE=1
AWS_STORAGE_BUCKET_NAME=prescriptions
AWS_S3_ENDPOINT_URL=https://bleztdeqdgijhmyymdsn.storage.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=ap-southeast-2
AWS_S3_ACCESS_KEY_ID=server-side-s3-access-key
AWS_S3_SECRET_ACCESS_KEY=server-side-s3-secret-key
